{
  "components": {
    "schemas": {
      "BatchRequest": {
        "description": "Which papers to pull in: one arXiv category, new or revised on or after a date.",
        "properties": {
          "category": {
            "examples": [
              "cs.IR"
            ],
            "title": "Category",
            "type": "string"
          },
          "since": {
            "format": "date",
            "title": "Since",
            "type": "string"
          }
        },
        "required": [
          "category",
          "since"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchResult": {
        "description": "What a batch did. `matched` exceeds `fetched` when the window spans more than one page.",
        "properties": {
          "added": {
            "title": "Added",
            "type": "integer"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "fetched": {
            "title": "Fetched",
            "type": "integer"
          },
          "matched": {
            "title": "Matched",
            "type": "integer"
          },
          "since": {
            "format": "date",
            "title": "Since",
            "type": "string"
          },
          "until": {
            "format": "date",
            "title": "Until",
            "type": "string"
          }
        },
        "required": [
          "category",
          "since",
          "until",
          "matched",
          "fetched",
          "added"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "What `/health` reports. `ok` is false when the database is unreachable.",
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Migration the database is on, null if never migrated",
            "title": "Revision"
          }
        },
        "required": [
          "ok",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PaperOut": {
        "properties": {
          "abstract": {
            "title": "Abstract",
            "type": "string"
          },
          "arxiv_id": {
            "title": "Arxiv Id",
            "type": "string"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "title": "Authors",
            "type": "array"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "arxiv_id",
          "title",
          "authors",
          "categories",
          "published_at",
          "abstract"
        ],
        "title": "PaperOut",
        "type": "object"
      },
      "PaperPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PaperOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PaperPage",
        "type": "object"
      },
      "SessionStatus": {
        "description": "Whether the caller is signed in, and whether signing in is even possible.\n\n`configured` is false when the deployment has no passphrase hash, so the\nlogin page can say that rather than blame the phrase you typed.",
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          }
        },
        "required": [
          "authenticated",
          "configured"
        ],
        "title": "SessionStatus",
        "type": "object"
      },
      "SignIn": {
        "description": "The one credential there is.",
        "properties": {
          "passphrase": {
            "minLength": 1,
            "title": "Passphrase",
            "type": "string"
          }
        },
        "required": [
          "passphrase"
        ],
        "title": "SignIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Rank documents against weighted criteria",
    "title": "sift",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/session": {
      "delete": {
        "operationId": "delete_session_auth_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Delete Session",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "description": "Whether the cookie in hand is good. The login page asks this on load.",
        "operationId": "read_session_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Session",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "create_session_auth_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/batches": {
      "post": {
        "description": "Fetch the listing and store what is new, before answering.",
        "operationId": "create_batch_batches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Batch",
        "tags": [
          "batches"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/papers": {
      "get": {
        "operationId": "get_papers_papers_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Papers",
        "tags": [
          "papers"
        ]
      }
    }
  }
}
