# Copy to .env for local work: `cp .env.example .env`.
#
# The passphrase behind this hash is "sift". It is here so that a fresh clone
# can sign in; the deployed stack gets its own hash from Secrets Manager, and a
# service with no hash at all admits nobody. Mint your own with:
#
#   sift passphrase
#
SIFT_PASSPHRASE_HASH=scrypt$16384$8$1$1CZ6nB7Ao_7I-oAFZL3bRQ$Hcwi9ARxqrzeCDd03DcOX4yVZ1VvNOfGv4w-IlgRDLI

# The database the test suite drops and recreates on every run. Give each
# checkout of the repository its own, so two suites never share one.
#
# SIFT_TEST_DATABASE_URL=postgresql+asyncpg://sift:sift@localhost:5433/sift_test

# Who answers the questions. `fake` (the default) is deterministic and needs no
# key, and downloads no PDFs unless SIFT_DOWNLOAD=true; `typesafe` asks Jev,
# needs TYPESAFE_API_KEY, and downloads the papers that pass the screen.
#
# Every API process runs the workers: whatever waits in the database is picked
# up as soon as the server starts.
#
# SIFT_ASKER=typesafe
# TYPESAFE_API_KEY=
